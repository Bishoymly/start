{
  "name": "@bishoymly/start",
  "version": "0.6.6",
  "description": "Create a verified v3 agent-ready Next.js workspace from a portable blueprint.",
  "keywords": [
    "nextjs",
    "scaffold",
    "starter",
    "ai-agent",
    "codex",
    "claude-code",
    "shadcn-ui",
    "typescript"
  ],
  "author": "Bishoy Youssef (https://bishoy.io)",
  "type": "module",
  "bin": {
    "start": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core.js",
    "./interactive": "./dist/interactive.js",
    "./render": "./dist/render.js"
  },
  "files": [
    "dist/cli.js",
    "dist/bootstrap.js",
    "dist/bootstrap.d.ts",
    "dist/core.js",
    "dist/core.d.ts",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/interactive.js",
    "dist/interactive.d.ts",
    "dist/render.js",
    "dist/render.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/*.test.js",
    "test:full-run": "npm run build && START_FULL_RUN=1 node --test dist/live-golden.test.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bishoymly/start"
  },
  "homepage": "https://bishoy.io/start",
  "bugs": {
    "url": "https://github.com/bishoymly/start/issues"
  },
  "funding": "https://github.com/sponsors/bishoymly",
  "publishConfig": {
    "access": "public"
  }
}
